# ---------------------------------------------------------
# 3. Customer Domains (Catch-All)
# ---------------------------------------------------------
:443 {
    # Automatic SSL (On-Demand)
    tls {
        on_demand
    }

    # Proxy to Next.js Multi-Tenant App
    reverse_proxy localhost:8092 {
        header_up Host {host}
    }
}

# ---------------------------------------------------------
# 4. Internal "Ask" Endpoint
# ---------------------------------------------------------
:5555 {
    # Always returns 200 to allow Caddy to issue certs
    respond /check 200
}
